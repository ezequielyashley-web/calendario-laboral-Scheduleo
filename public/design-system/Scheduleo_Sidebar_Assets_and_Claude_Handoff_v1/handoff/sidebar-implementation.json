  "typography": {
    "font": "Inter",
    "brand": "28px 700",
    "section": "12px 700 uppercase",
    "item": "15px 600",
    "status": "12px 600"
  },
  "routes": {
    "assets": "/design-system/sidebar"
  },
  "rules": [
    "No inventar iconos.",
    "Usar sidebar-background.svg.",
    "Usar active-menu-item.svg para el activo.",
    "No tocar Header ni contenido principal.",
    "Mantener las sombras indicadas."
